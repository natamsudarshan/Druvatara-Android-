{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/claude-mem.js"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "command": "opencode run /document-generate --changed-file {file} --auto-commit"
      }
    ],
    "Stop": [
      {
        "command": "opencode run /document-release --auto"
      }
    ]
  },
  "plugin": [
    "./plugins/claude-mem.js"
  ],
  "gstack": {
    "autoInstall": true,
    "autoUpdate": true,
    "teamMode": true,
    "autoDocument": true,
    "documentOn": "write",
    "commitDocs": true
  }
}